COMMON_FLAGS="-O2 -pipe"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"

MAKEOPTS="$(nproc)"
EMERGE_DEFAULT_OPTS="--jobs=2 --load-average=2"

# Prefer AthanorOS binary packages when a matching build exists.
# The repository endpoint itself is configured in binrepos.conf/athanor.conf.
FEATURES="${FEATURES} buildpkg getbinpkg binpkg-multi-instance"
# TRYING TO GET IT TO USE BINS PLS
EMERGE_DEFAULT_OPTS="${EMERGE_DEFAULT_OPTS} --getbinpkg=y --binpkg-respect-use=n"
PORTAGE_BINHOST="https://choccynix.github.io/binhost"

CC="clang"
CXX="clang++"
AR="llvm-ar"
NM="llvm-nm"
RANLIB="llvm-ranlib"

USE="musl -systemd -pam -nls unicode"
ACCEPT_LICENSE="*"
ACCEPT_KEYWORDS="amd64"

